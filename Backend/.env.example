NODE_ENV=production
PORT=5001
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_strong_random_jwt_secret_here
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=your_from_email_here
FRONTEND_URL=https://your-frontend-domain.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CRM_API_URL=https://your-crm-endpoint.com/api/leads/capture
CRM_API_KEY=your_crm_api_key_here

# Seed script credentials (only needed when running utils/seed.js)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your_strong_admin_password_here
SEED_MANAGER_EMAIL=manager@yourdomain.com
SEED_MANAGER_PASSWORD=your_strong_manager_password_here
SEED_HR_EMAIL=hr@yourdomain.com
SEED_HR_PASSWORD=your_strong_hr_password_here