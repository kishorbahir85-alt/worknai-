PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/worknai
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Required only for Google login.
GOOGLE_CLIENT_ID=

# Required only for forgot/reset password and OTP emails.
# Gmail mode (default): SMTP_USER + SMTP_PASS (app password).
# Relay mode (Brevo/Resend/etc.): also set SMTP_HOST, SMTP_PORT and SMTP_FROM.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# Required only for CRM lead sync (billpay.business).
CRM_API_URL=https://billpay.business/api/leads/capture
CRM_API_KEY=<PASTE_KEY_HERE>
